{
  "devCommand": "react-scripts start",
  "buildCommand": "react-scripts build",
  "outputDirectory": "build",
  "rewrites": [
    { "source": "/imageGallery/(.*)", "destination": "/imageGallery/$1" },
    {
      "source": "/((?!api/|static/|imageGallery/|favicon\\.ico|manifest\\.json|asset-manifest\\.json|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
